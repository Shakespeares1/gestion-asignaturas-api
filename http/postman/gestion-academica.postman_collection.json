{
  "info": {
    "name": "Gestión Académica API",
    "description": "Cobertura HTTP para autenticación, asignaturas, usuarios, reportes, OpenAPI y readiness. Comenzar con localhost o un entorno de staging aislado; las solicitudes CRUD modifican datos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "assignmentId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login responde 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('userToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login responde 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro público USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Usuario de prueba\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\",\n  \"role\": \"ADMIN\",\n  \"accountStatus\": \"INACTIVO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/usuarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registro responde 201 (sin elevar rol/estado)', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { const u = pm.response.json(); pm.collectionVariables.set('userId', u.id); pm.test('El registro público crea USER activo', () => { pm.expect(u.role).to.eql('USER'); pm.expect(u.accountStatus).to.eql('ACTIVO'); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Solicitar recuperación (respuesta genérica; requiere SMTP para procesar correo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/forgot-password"
          }
        },
        {
          "name": "Restablecer contraseña (ingresar token obtenido por canal seguro)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newUserPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/reset-password"
          }
        }
      ]
    },
    {
      "name": "Asignaturas (USER consulta; ADMIN escribe)",
      "item": [
        {
          "name": "Listar asignaturas (USER)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/asignaturas"
          }
        },
        {
          "name": "Consultar asignatura (USER)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/asignaturas/{{assignmentId}}"
          }
        },
        {
          "name": "Crear asignatura (ADMIN; guarda assignmentId)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Arquitectura de software\",\n  \"nombreCompleto\": \"Arquitectura de software\",\n  \"descripcion\": \"Registro de prueba de API\",\n  \"areaConocimiento\": \"Sistemas\",\n  \"carrera\": \"Ingeniería de Software\",\n  \"numeroCreditos\": 3,\n  \"contenidoTematico\": \"Diseño y arquitectura\",\n  \"semestre\": 5,\n  \"profesor\": \"Docente de prueba\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/asignaturas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Crear responde 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('assignmentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar asignatura (ADMIN)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Arquitectura de software II\",\n  \"nombreCompleto\": \"Arquitectura de software II\",\n  \"descripcion\": \"Actualización de prueba\",\n  \"areaConocimiento\": \"Sistemas\",\n  \"carrera\": \"Ingeniería de Software\",\n  \"numeroCreditos\": 4,\n  \"contenidoTematico\": \"Diseño y arquitectura\",\n  \"semestre\": 5,\n  \"profesor\": \"Docente de prueba\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/asignaturas/{{assignmentId}}"
          }
        },
        {
          "name": "Eliminar asignatura (ADMIN; usar solo en entorno aislado)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/asignaturas/{{assignmentId}}"
          }
        }
      ]
    },
    {
      "name": "Usuarios (ADMIN; registro público en Autenticación)",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/usuarios"
          }
        },
        {
          "name": "Consultar usuario",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/usuarios/{{userId}}"
          }
        },
        {
          "name": "Actualizar nombre y email",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Usuario de prueba actualizado\",\n  \"email\": \"{{newUserEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/usuarios/{{userId}}"
          }
        },
        {
          "name": "Cambiar rol/estado",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"USER\",\n  \"accountStatus\": \"ACTIVO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/usuarios/{{userId}}/access"
          }
        },
        {
          "name": "Cambiar rol/estado (PUT compatible con Kodular Web)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"USER\",\n  \"accountStatus\": \"ACTIVO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/usuarios/{{userId}}/access"
          }
        },
        {
          "name": "Eliminar usuario (usar solo en entorno aislado)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/usuarios/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Reportes",
      "item": [
        {
          "name": "Asignaturas por carrera, semestre y área (USER o ADMIN)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/reportes/asignaturas/carrera-semestre-area?carrera=Ingenieria%20de%20Software&semestre=5&areaConocimiento=sistemas&page=0&size=50"
          }
        },
        {
          "name": "Asignaturas por créditos, profesor y nombre (USER o ADMIN)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/reportes/asignaturas/creditos-profesor-nombre?numeroCreditosMin=3&numeroCreditosMax=5&profesor=ana&nombre=datos&page=0&size=50"
          }
        },
        {
          "name": "Usuarios por rol y estado (ADMIN)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/reportes/usuarios/rol-estado?role=USER&accountStatus=ACTIVO&page=0&size=50"
          }
        },
        {
          "name": "Usuarios por fecha de registro (ADMIN)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/reportes/usuarios/fecha-registro?fechaDesde=2026-01-01&fechaHasta=2026-12-31&page=0&size=50"
          }
        }
      ]
    },
    {
      "name": "Documentación y health",
      "item": [
        {
          "name": "OpenAPI JSON",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v3/api-docs"
          }
        },
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/swagger-ui.html"
          }
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health/readiness"
          }
        }
      ]
    }
  ]
}
